<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PrezenterServer</RootNamespace>
    <AssemblyName>PrezenterServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- System volume/mute control via WASAPI endpoint volume (NAudio.CoreAudioApi namespace) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- QR code generation for pairing -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- mDNS advertisement of _prezenter._tcp.local. -->
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <!-- Minimal, dependency-free tray icon support -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

</Project>
